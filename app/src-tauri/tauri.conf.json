{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Treasure Launcher",
  "mainBinaryName": "treasure-launcher",
  "version": "0.1.0",
  "identifier": "io.github.treasureclient.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Treasure Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "maximized": true,
        "backgroundColor": "#0F0A05",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Minecraft launcher with Treasure Client, Modrinth and instances",
    "longDescription": "Treasure Launcher installs and starts Minecraft with Treasure Client and the Treasure Pack, lets you make instances, and browse and install modpacks, mods, resource packs and shaders from Modrinth.",
    "publisher": "Treasure Client",
    "homepage": "https://treasureclient.github.io",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": { "depends": [] },
      "rpm": { "depends": [] }
    }
  }
}
