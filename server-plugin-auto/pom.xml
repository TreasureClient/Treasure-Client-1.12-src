<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.treasureclient</groupId>
    <artifactId>TreasureViaAuto</artifactId>
    <version>0.1</version>
    <packaging>jar</packaging>
    <name>TreasureViaAuto</name>
    <description>Treasure Client — Option A phase 4: automatic modern-block
        down-mapping on a 1.13+ backend. Detects real modern blocks placed in the
        world and streams our ViaBlocks state ids to Treasure Clients over the
        same TC|ViaBlocks channel — no manual commands.</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <!-- Modern Spigot/Paper API. If this repo is unreachable, install the
             API locally with BuildTools (a 1.17+ rev) or point at papermc's repo.
             Any 1.13+ API works; the plugin only uses version-stable calls. -->
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>sonatype</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Modern Bukkit/Spigot API (compile-only; provided by the server).
             1.20.4 chosen as a recent LTS-ish target; drop to your backend's
             version if you prefer. Only version-stable API is used. -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.20.4-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>TreasureViaAuto</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
        </resources>
    </build>
</project>
